# Slim, native-arch image for the imo_grading domain only (no GPU/torch/genesis/balrog/proofgrader).
# Built and tagged `hyperagents` so generate_loop's build_container reuses it and skips the CUDA Dockerfile.
# The repo is bind-mounted into /hyperagents at runtime, so we only need the Python env + deps here.
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# git is needed by GitPython (diffing) inside the container; build-essential covers any sdist builds.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /hyperagents

# Only the deps the imo_grading code path actually imports (harness top-level imports hydra;
# grading uses litellm/pandas/sympy; misc utils use the rest). No torch/genesis/balrog/proofgrader.
RUN pip install --no-cache-dir \
    requests==2.32.4 \
    dotenv==0.9.9 \
    tqdm==4.67.1 \
    backoff==2.2.1 \
    docker==7.1.0 \
    datasets==3.6.0 \
    GitPython==3.1.44 \
    litellm==1.74.9 \
    pandas==2.3.2 \
    sympy==1.14.0 \
    hydra-core==1.3.2 \
    numpy

CMD ["tail", "-f", "/dev/null"]
